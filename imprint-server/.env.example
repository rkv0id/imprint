# imprint-server configuration
# Copy to .env and fill in your values.
# All variables are optional -- defaults are shown.

# -- Store (required for production) ------------------------------------------

# SQLite (default, local use and development)
IMPRINT_STORE=sqlite:///~/.imprint/imprint.db

# Postgres (production, multi-worker)
# IMPRINT_STORE=postgres://user:pass@localhost:5432/imprint

# -- Server -------------------------------------------------------------------

IMPRINT_HOST=0.0.0.0
IMPRINT_PORT=8000
IMPRINT_WORKERS=1
# For multi-worker Postgres deployments: set IMPRINT_WORKERS to CPU count.
# SQLite mode must stay at IMPRINT_WORKERS=1.

# -- Library defaults (applied to agents with no explicit config) -------------

IMPRINT_DEFAULT_MODEL=anthropic:claude-haiku-4-5-20251001
IMPRINT_DEFAULT_MODE=balanced
# default_mode: frugal | balanced | eager

# -- Auth ---------------------------------------------------------------------

# Disabled by default for local use. Set false to require API keys.
IMPRINT_AUTH_DISABLED=true

# When auth is enabled and no keys exist, the server auto-generates a master
# key on startup and prints it once to stdout. Use `imprint-server keys` to
# manage keys after that.

# -- Logging + CORS -----------------------------------------------------------

IMPRINT_LOG_FORMAT=text
# log_format: text (human-readable) | json (structured, for production)

IMPRINT_CORS_ORIGINS=*
# Comma-separated allowed origins. Example:
# IMPRINT_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# -- Connection pool (Postgres only) ------------------------------------------

IMPRINT_POOL_MIN=2
IMPRINT_POOL_MAX=10

# -- Scheduler intervals (seconds) --------------------------------------------

IMPRINT_DECAY_SWEEP_INTERVAL=21600    # 6h
IMPRINT_CONSOLIDATE_INTERVAL=86400    # 24h
IMPRINT_SESSION_TTL=3600              # 1h -- expired sessions are closed by sweeper

# -- Confusion-based consolidation --------------------------------------------

IMPRINT_CONFUSION_WINDOW=10           # recent observations to check
IMPRINT_CONFUSION_THRESHOLD=0.3       # correction rate to trigger early consolidation

# -- Per-context alpha tuning -------------------------------------------------

IMPRINT_ALPHA_MIN_SAMPLES=20          # min policy_events per context hash

# -- MCP ----------------------------------------------------------------------

# Required when using the MCP SSE endpoint (/mcp/sse).
# The MCP endpoint is scoped to one agent and one user namespace.
IMPRINT_MCP_AGENT_ID=
IMPRINT_MCP_USER_ID=
