# imprint-server configuration
# Copy to .env and fill in your values.
# All IMPRINT_* variables are optional -- defaults are shown.
#
# Docker Compose quick start:
#   cp imprint-server/.env.example imprint-server/.env
#   # Set LLM API keys below, then:
#   just server-docker-up

# -- LLM API keys (required for balanced and eager processing modes) ----------
#
# imprint-server calls language models to detect signals, derive memories, and
# compile behavioral policies. Set the key(s) for the provider(s) you use.
# frugal mode (heuristic-only) does not require any API key.

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=         # for OpenAIEmbedder (dense retrieval)
# VOYAGE_API_KEY=         # for VoyageEmbedder (dense retrieval)

# -- Store --------------------------------------------------------------------

# SQLite (default, local use and development -- zero infrastructure)
IMPRINT_STORE=sqlite:///~/.imprint/imprint.db

# Postgres (production, multi-worker deployments)
# IMPRINT_STORE=postgres://user:pass@localhost:5432/imprint
#
# Docker Compose sets this automatically:
#   IMPRINT_STORE=postgres://imprint:imprint@postgres:5432/imprint

# -- Server -------------------------------------------------------------------

IMPRINT_HOST=0.0.0.0
IMPRINT_PORT=8000
IMPRINT_WORKERS=1
# Multi-worker Postgres: set to CPU count (e.g. 4).
# SQLite must stay at 1.

# -- Library defaults (applied to agents with no explicit config) -------------

IMPRINT_DEFAULT_MODEL=anthropic:claude-haiku-4-5-20251001
IMPRINT_DEFAULT_MODE=balanced
# default_mode: frugal (no LLM) | balanced (recommended) | eager (full LLM)

# -- Retrieval and learning ---------------------------------------------------

# Embedder provider for dense (vector) retrieval.
# none: FTS only, no embedder API calls (default).
# voyage: VoyageEmbedder -- requires VOYAGE_API_KEY above.
# openai: OpenAIEmbedder -- requires OPENAI_API_KEY above.
IMPRINT_EMBEDDER=none
IMPRINT_EMBEDDER_MODEL=voyage-3         # model string for the chosen provider
IMPRINT_EMBEDDER_DIM=1024              # output dimension; must match vector store

# Vector store backend.
# none: dense retrieval disabled (default).
# sqlite-vec: local SQLite vector store -- requires IMPRINT_EMBEDDER != none and SQLite store.
# postgres: pgvector -- requires IMPRINT_EMBEDDER != none and Postgres store.
IMPRINT_VECTOR_STORE=none

# Memory decay model.
# static: FSRSStaticDecay, no extra deps (default).
# gradient: FSRSGradientDecay -- requires imprint-mem[online] (River).
IMPRINT_DECAY_MODEL=static

# -- Auth ---------------------------------------------------------------------

# Disabled by default for local use. Set false to require API keys.
IMPRINT_AUTH_DISABLED=true

# When auth is enabled and no keys exist in the DB, the server auto-generates
# a master key on startup and prints it once to stdout.
# Use `imprint-server keys create/list/revoke` to manage keys after that.

# -- Logging + CORS -----------------------------------------------------------

IMPRINT_LOG_FORMAT=text
# Production: use json for structured log aggregation.

IMPRINT_CORS_ORIGINS=*
# Comma-separated allowed origins for CORS:
# IMPRINT_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# -- Connection pool (Postgres only) ------------------------------------------

IMPRINT_POOL_MIN=2
IMPRINT_POOL_MAX=10

# -- Scheduler ----------------------------------------------------------------

IMPRINT_CONSOLIDATE_INTERVAL=86400    # 24h -- prune decayed memories + scope consolidation
IMPRINT_SESSION_TTL=3600              # 1h  -- inactive HTTP sessions expire after this

# Confusion-based early consolidation:
# After observe(), if the recent correction rate exceeds the threshold,
# consolidation runs immediately rather than waiting for the interval.
IMPRINT_CONFUSION_WINDOW=10           # recent observations to check
IMPRINT_CONFUSION_THRESHOLD=0.3       # correction rate threshold (0.0-1.0)

# -- Per-context alpha tuning (Phase 2 learning) ------------------------------

IMPRINT_ALPHA_MIN_SAMPLES=20          # min policy_events per context hash before
                                      # per-context retrieval weights are applied

# -- MCP (Claude Code, Cursor, Continue) --------------------------------------

# Required when using the MCP SSE endpoint at /mcp/sse.
# The MCP endpoint is pre-scoped to one agent and one user namespace.
# All MCP tool calls operate within this scope.
IMPRINT_MCP_AGENT_ID=
IMPRINT_MCP_USER_ID=
