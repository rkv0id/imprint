# Imprint reads environment variables from .env via just's dotenv-load.
# Copy this file to .env and fill in values. .env is gitignored.
#
#   cp .env.example .env

# Required for the LLM pipeline and `just test-live`.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required for imprint[openai] (OpenAIEmbedder, OpenAITokenCounter).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required for imprint[voyage] live tests (VoyageEmbedder, VoyageTokenCounter).
# Get one at https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=


# Required for the Postgres live test and examples/with_postgres.py.
# For local testing use `just postgres-dev` (Docker pgvector image) and set:
#   IMPRINT_POSTGRES_URL=postgres://imprint:imprint@localhost/imprint_test
# For a remote instance use a standard Postgres connection URL:
#   IMPRINT_POSTGRES_URL=postgres://user:pass@host:5432/dbname
# Requires: pip install imprint-mem[postgres]
IMPRINT_POSTGRES_URL=
