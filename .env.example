# Imprint reads environment variables from .env via just's dotenv-load.
# Copy this file to .env and fill in values. .env is gitignored.
#
#   cp .env.example .env

# Required for the LLM pipeline and `just test-live`.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required for imprint[voyage] live tests (VoyageEmbedder, VoyageTokenCounter).
# Get one at https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=

# Required for the Turso live test against a real remote database.
# For local testing use `just turso-dev` (Docker) and set:
#   TURSO_DATABASE_URL=http://127.0.0.1:8080   (http:// works)
#   TURSO_DATABASE_URL=ws://127.0.0.1:8080     (ws:// also works)
# For Turso cloud, get these from https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
